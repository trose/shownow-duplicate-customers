{
  "name": "shownow-duplicate-customers",
  "version": "1.0.0",
  "description": "This is a monorepo for Salesforce and React components to handle duplicate customer records.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "eslint src/react --ext .js,.jsx,.ts,.tsx",
    "test": "npm run test:react && npm run test:salesforce",
    "test:react": "jest src/react",
    "test:salesforce": "sfdx force:apex:test:run --tests DuplicateMatcherTest,DuplicateRestServiceTest --resultformat human --codecoverage --wait 10",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/react/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "eslint": "^9.38.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^15.5.2"
  }
}
